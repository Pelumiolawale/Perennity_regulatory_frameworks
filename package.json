{
  "name": "@perennity/engine",
  "version": "4.0.0-alpha.1",
  "description": "Perennity Bridge deterministic scoring engine — v3.5 legacy path (EU Taxonomy 8.1 + SFDR Art 8/9 + UK SDR) + v4.0 framework-modular lens architecture (MetricsCore + SFDR 2.0 / UK SDR / US lenses)",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./v4": {
      "types": "./dist/v4/index.d.ts",
      "default": "./dist/v4/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "regulatory-knowledge",
    "config",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "test": "node --import tsx --test $(find src -name '*.test.ts' | sort)"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "fast-glob": "^3.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
